{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.cjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node-pg-migrate up --migrations-dir src/db/migrations",
    "db:migrate:test": "node-pg-migrate up --migrations-dir src/db/migrations"
  },
  "dependencies": {
    "@app/shared": "*",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@sentry/node": "^11.10.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "ws": "^8.22.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "node-pg-migrate": "^7.0.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
