{
  "name": "@app/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node-pg-migrate up --migrations-dir src/db/migrations",
    "db:migrate:test": "node-pg-migrate up --migrations-dir src/db/migrations"
  },
  "dependencies": {
    "@app/shared": "*",
    "express": "^5.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "node-pg-migrate": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
