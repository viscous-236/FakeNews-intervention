{
  "name": "fakenews-intervention",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "node --env-file=.env ./node_modules/.bin/tsx watch apps/api/src/index.ts",
    "dev:web": "npm run dev -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,cjs,mjs,css}\" \"packages/**/*.{ts,js,cjs}\" \"scripts/**/*.{ts,js,cjs,mjs}\" \"tools/**/*.{ts,js,cjs}\" \"e2e/**/*.ts\" \"*.{js,cjs,ts}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,cjs,mjs,css}\" \"packages/**/*.{ts,js,cjs}\" \"scripts/**/*.{ts,js,cjs,mjs}\" \"tools/**/*.{ts,js,cjs}\" \"e2e/**/*.ts\" \"*.{js,cjs,ts}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "node --env-file=.env ./node_modules/.bin/node-pg-migrate up --migrations-dir apps/api/src/db/migrations",
    "db:migrate:test": "npm run db:migrate:test -w apps/api",
    "docs:openapi": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "autocannon": "^8.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.13.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
