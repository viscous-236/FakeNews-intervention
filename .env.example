# ============================================================
# FakeNews Intervention Platform — Environment Variables
# Copy to .env and fill in your values.
# ALL variables listed in Section 1.9 of the plan.
# ============================================================

# --------------- Server ------------------------------------------
NODE_ENV=development
PORT=3000
# Exact origin used for Origin check (REQ-025) and email links.
# In production: set to your public HTTPS URL.
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=info

# --------------- Database ----------------------------------------
# Required. Format: postgresql://<user>:<pass>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Optional: Direct (non-pooled) connection for migrations.
# Defaults to DATABASE_URL when not set.
# DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/app
DATABASE_POOL_MAX=10

# --------------- Session -----------------------------------------
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=30
# Defaults to true in production, false otherwise.
# COOKIE_SECURE=false

# --------------- Detector ----------------------------------------
# Required. Base URL of the FastAPI detector service.
DETECTOR_URL=http://localhost:8001
# Required. Must match DETECTOR_API_KEY in docker-compose.yml / detector env.
DETECTOR_API_KEY=test-detector-key
DETECTOR_TIMEOUT_MS=15000
DETECTOR_WARMUP_TIMEOUT_MS=90000
DETECTOR_MAX_ATTEMPTS=3
# Comma-separated retry backoff seconds for each attempt.
DETECTOR_BACKOFF_SECONDS=30,120,600
DETECTOR_POLL_INTERVAL_MS=2000

# --------------- Detection thresholds ----------------------------
# Updated by TASK-036 after model training and threshold selection.
FAKE_THRESHOLD_HIGH=0.65
REAL_THRESHOLD_LOW=0.35

# --------------- Scoring -----------------------------------------
SIGMA_DEFAULT=0.500
FORMULA_VERSION=paper-eq2-v1
# 0 disables automatic wave finalization.
WAVE_AUTO_FINALIZE_INTERVAL_HOURS=0
AUTO_REAL_ENABLED=true
AUTO_REAL_DELAY_MINUTES=60
RESHARE_PENALTY_ENABLED=true
MAX_RESPONSIBLE_POST_EVENTS_PER_WAVE=5
MAX_VALID_REPORT_EVENTS_PER_WAVE=5
APPEAL_WINDOW_DAYS=14
EDIT_WINDOW_MINUTES=15
Q_TRUSTED_MIN=3.000
Q_LOW_MAX=-1.500
HOLD_LOW_TIER_POSTS=false
# tier_only: q visible only to the user and admins. full: q is public.
PUBLIC_SCORE_VISIBILITY=tier_only
REQUIRE_EMAIL_VERIFICATION=true

# --------------- Object storage (S3-compatible) ------------------
# Local: MinIO via docker-compose
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/app-media
# true for MinIO (path-style); false for R2 / AWS (virtual-hosted)
S3_FORCE_PATH_STYLE=true

# --------------- SMTP --------------------------------------------
# Local: Mailpit (real SMTP server, captures all mail, no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@example.com

# --------------- Observability -----------------------------------
# Optional. Sentry is disabled when this is empty.
# SENTRY_DSN=https://your-key@sentry.io/123456
# Required in production. Token for GET /metrics (Bearer).
# METRICS_TOKEN=change-me-in-production

# --------------- Detector service (services/detector) -----------
# Used by the detector container, not by the API.
# DETECTOR_API_KEY is shared above.
# MODEL_DIR=/app/artifacts
# PORT=8001
